<view class="container">
    <view class="card">
        <view class="section-title mb16">输入证书信息</view>
        <view class="form-item">
            <text class="form-label required">证书编号</text>
            <input class="form-input" placeholder="请输入证书编号" value="{{certNo}}" bindinput="onCertNoInput" />
        </view>
        <view class="form-item">
            <text class="form-label">验真码（选填）</text>
            <input class="form-input" placeholder="输入验真码可精确核验" value="{{verifyCode}}" bindinput="onCodeInput" />
        </view>
        <button class="primary-btn mt24" bindtap="doVerify" disabled="{{viewState === 'loading'}}">立即验真</button>
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="card state-box">
        <view class="spinner"></view>
        <text class="state-text">正在核验…</text>
    </view>

    <view wx:elif="{{viewState === 'error'}}" class="card state-box">
        <text class="state-icon">!</text>
        <text class="state-text">{{errorMsg}}</text>
        <button class="ghost-btn mt16" size="mini" bindtap="doVerify">重试</button>
    </view>

    <view wx:elif="{{result}}" class="card result-card">
        <block wx:if="{{result.valid}}">
            <view class="result-head valid">
                <text class="result-icon">✓</text>
                <view>
                    <view class="result-title">证书真实有效</view>
                    <view class="result-sub mt8">该证书由绿益公益平台签发</view>
                </view>
            </view>
            <view class="divider"></view>
            <view class="info-row"><text class="info-label">证书名称</text><text class="info-value">{{result.title}}</text></view>
            <view class="info-row"><text class="info-label">证书编号</text><text class="info-value">{{result.certNo}}</text></view>
            <view class="info-row"><text class="info-label">持有人</text><text class="info-value">{{result.holderName}}</text></view>
            <view class="info-row"><text class="info-label">证书类别</text><text class="info-value">{{result.categoryLabel}}</text></view>
            <view class="info-row"><text class="info-label">签发日期</text><text class="info-value">{{result.issuedAt}}</text></view>
        </block>
        <block wx:else>
            <view class="result-head invalid">
                <text class="result-icon">×</text>
                <view>
                    <view class="result-title">验真未通过</view>
                    <view class="result-sub mt8">{{result.message || '证书不存在或已作废'}}</view>
                </view>
            </view>
        </block>
        <button class="ghost-btn mt24" bindtap="reset">继续验真</button>
    </view>

    <view wx:else class="card tips-card">
        <view class="section-title mb16">验真说明</view>
        <view class="tip-line">1. 证书编号可在荣誉档案的证书列表中查看。</view>
        <view class="tip-line">2. 输入验真码可进一步精确核验证书状态。</view>
        <view class="tip-line">3. 验真为公开服务，无需登录即可使用。</view>
    </view>
</view>
