<view class="container">
    <view wx:if="{{loadError}}" class="load-error" bindtap="openDiagnose">
        <view class="le-title">数据加载失败（点此诊断）</view>
        <view class="le-detail">{{loadError}}</view>
    </view>
    <view class="brand-card">
        <view class="row">
            <view class="brand-logo">绿</view>
            <view class="grow">
                <view class="brand-name">绿益公益</view>
                <view class="brand-slogan">让每一份善意都被看见</view>
            </view>
        </view>
        <view class="brand-stats">
            <view class="stat-item"><text class="stat-num">2018</text><text class="stat-label">扎根青岛</text></view>
            <view class="stat-item"><text class="stat-num">10+</text><text class="stat-label">年度集市</text></view>
            <view class="stat-item"><text class="stat-num">千余</text><text class="stat-label">惠及家庭</text></view>
        </view>
    </view>

    <view class="quick-grid">
        <view class="quick-item" wx:for="{{quickEntries}}" wx:key="key" data-path="{{item.path}}" bindtap="goPage">
            <view class="quick-icon" style="background:{{item.color}}">{{item.icon}}</view>
            <text class="quick-label">{{item.label}}</text>
        </view>
    </view>

    <!-- 公益活动 -->
    <view class="section-head">
        <text class="title">公益活动</text>
        <text class="text-muted" data-path="/pages/activity/activity" bindtap="goPage">更多 ›</text>
    </view>
    <view class="card activity-home-card" wx:for="{{activities}}" wx:key="id" data-id="{{item.id}}" bindtap="openActivity">
        <view class="row between">
            <text class="title a-title">{{item.title}}</text>
            <text class="tag {{item.status === 'FINISHED' ? 'tag-warn' : ''}}">{{item.statusText}}</text>
        </view>
        <view class="a-banner" wx:if="{{item.coverUrl}}"><image src="{{item.coverUrl}}" mode="aspectFill" class="banner-img"></image></view>
        <view class="subtitle mt8">{{item.timeText}} · {{item.location || '待定'}}</view>
        <view class="row between mt8">
            <text class="text-muted">名额 {{item.signedCount || 0}}/{{item.quota}}</text>
            <text class="text-green">查看详情 ›</text>
        </view>
    </view>
    <view wx:if="{{viewState === 'ready' && activities.length === 0}}" class="card center" style="padding:40rpx">
        <text class="state-text">暂无进行中的活动</text>
    </view>

    <!-- 公众号精选 -->
    <view wx:if="{{oaArticles.length > 0}}">
        <view class="section-head">
            <text class="title">公众号精选</text>
            <text class="text-muted">绿益公益公众号</text>
        </view>
        <view class="card article-card" wx:for="{{oaArticles}}" wx:key="id" data-id="{{item.id}}" data-url="{{item.videoUrl}}" bindtap="openOaArticle">
            <view class="article-cover" wx:if="{{item.coverUrl}}">
                <image src="{{item.coverUrl}}" mode="aspectFill" class="cover-img"></image>
            </view>
            <view class="grow">
                <view class="title">{{item.title}}</view>
                <view class="subtitle mt8">来自公众号 · 点击阅读原文</view>
            </view>
            <text class="oa-arrow">›</text>
        </view>
    </view>

    <view class="section-head">
        <text class="title">公益动态</text>
        <text class="text-muted" data-path="/pages/article/article" bindtap="goPage">更多 ›</text>
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="card center" style="padding:60rpx">
        <view class="spinner"></view><text class="state-text">加载中…</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="card center" style="padding:60rpx">
        <text class="state-icon">!</text><text class="state-text">加载失败</text>
        <button class="ghost-btn mt16" size="mini" bindtap="loadData">重试</button>
    </view>
    <block wx:else>
        <view class="card article-card" wx:for="{{contents}}" wx:key="id" data-id="{{item.id}}" bindtap="openArticle">
            <view class="article-cover" wx:if="{{item.coverUrl}}">
                <image src="{{item.coverUrl}}" mode="aspectFill" class="cover-img"></image>
            </view>
            <view class="grow">
                <view class="title">{{item.title}}</view>
                <view class="subtitle mt8">{{item.kind === 'VIDEO' ? '短视频' : '图文'}} · 绿益公益</view>
            </view>
        </view>
        <view wx:if="{{contents.length === 0}}" class="card center" style="padding:60rpx">
            <text class="state-icon">○</text><text class="state-text">暂无动态</text>
        </view>
    </block>

    <button class="ghost-btn mt24" bindtap="openChat">公益小助手（AI 客服）</button>
</view>
