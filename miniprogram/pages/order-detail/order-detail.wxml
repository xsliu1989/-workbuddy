<view class="container">
    <view wx:if="{{viewState === 'loading'}}" class="card center state-box">
        <view class="spinner"></view>
        <text class="state-text">订单详情加载中…</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="card center state-box">
        <text class="state-icon">!</text>
        <text class="state-text">{{errorMsg}}</text>
        <button class="ghost-btn mt16" size="mini" bindtap="retryLoad">重试</button>
    </view>

    <block wx:else>
        <view class="card status-card">
            <view class="status-title">{{order.statusLabel}}</view>
            <view class="text-muted mt8">订单号 {{order.orderNo}} <text class="copy" bindtap="copyOrderNo">复制</text></view>
            <view class="text-muted mt8">下单时间 {{order.createdAt}}</view>
        </view>

        <view wx:if="{{order.address}}" class="card">
            <view class="title mb16">收货地址</view>
            <view class="row">
                <text class="bold">{{order.address.receiver}}</text>
                <text class="subtitle">{{order.address.phone}}</text>
            </view>
            <view class="text-muted mt8">{{order.address.fullAddress}}</view>
        </view>

        <view wx:if="{{order.status === 'RETURN_APPLYING'}}" class="card return-notice">
            退货申请已提交，等待平台审核。审核通过后货款与积分将退回。
        </view>

        <view wx:if="{{order.logisticsNo}}" class="card">
            <view class="between">
                <text class="title">物流信息</text>
                <text class="text-green" bindtap="copyLogistics">复制单号 ›</text>
            </view>
            <view class="logistics-no mt8">{{order.logisticsNo}}</view>
        </view>

        <view class="card">
            <view class="title mb16">物流跟踪</view>
            <view class="step" wx:for="{{steps}}" wx:key="title">
                <view class="step-line" wx:if="{{index < steps.length - 1}}"></view>
                <view class="step-dot {{item.done ? 'done' : ''}}"><text wx:if="{{item.done}}">✓</text></view>
                <view class="step-body">
                    <view class="between">
                        <text class="step-title {{item.done ? 'done' : ''}}">{{item.title}}</text>
                        <text wx:if="{{item.time}}" class="text-muted">{{item.time}}</text>
                    </view>
                    <view class="step-desc">{{item.desc}}</view>
                </view>
            </view>
        </view>

        <view class="card">
            <view class="title mb16">商品明细</view>
            <view class="item-row" wx:for="{{items}}" wx:key="id">
                <text class="grow item-name">{{item.name}}</text>
                <text class="text-muted">×{{item.quantity}}</text>
                <text class="item-price">¥{{item.price}}</text>
            </view>
        </view>

        <view class="card">
            <view class="title mb16">费用明细</view>
            <view class="between fee-row"><text class="subtitle">商品金额</text><text>¥{{order.goodsAmount}}</text></view>
            <view class="between fee-row"><text class="subtitle">运费</text><text>¥{{order.freightAmount}}</text></view>
            <view class="between fee-row"><text class="subtitle">积分抵扣</text><text class="text-green">-¥{{order.discountAmount}}</text></view>
            <view class="divider"></view>
            <view class="between"><text class="title">实付款</text><text class="pay-amount">¥{{order.payAmount}}</text></view>
        </view>

        <button wx:if="{{order.payStatus === 'PAID' && (order.status === 'PAID' || order.status === 'SHIPPED' || order.status === 'COMPLETED')}}" class="ghost-btn refund-btn" bindtap="openAfterSale">申请售后</button>
        <button class="primary-btn mt16" bindtap="goMall">继续逛逛</button>
    </block>

    <!-- 售后方式选择 -->
    <view wx:if="{{showAfterSale}}" class="mask" bindtap="closeAfterSale"></view>
    <view wx:if="{{showAfterSale}}" class="sheet after-sale-sheet">
        <view class="sheet-head">
            <text class="title">申请售后</text>
            <text class="sheet-close" bindtap="closeAfterSale">关闭</text>
        </view>
        <view class="sheet-body">
            <view class="text-muted">请选择售后方式。退货退款需将商品寄回，平台审核通过后会退回货款与积分。</view>
            <button class="primary-btn mt24" bindtap="applyRefundOnly">仅退款（未发货适用）</button>
            <button class="ghost-btn mt16" bindtap="applyReturnGoods">退货退款（需寄回商品）</button>
            <button class="ghost-btn mt16" bindtap="closeAfterSale">取消</button>
        </view>
    </view>
</view>
