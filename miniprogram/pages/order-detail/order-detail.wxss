.status-card { border-left: 8rpx solid #2e7d5b; }
.status-title { font-size: 40rpx; font-weight: 700; color: #2e7d5b; }
.copy { color: #2e7d5b; margin-left: 12rpx; }
.logistics-no { font-size: 30rpx; font-weight: 600; color: #1f2329; background: #f7f8fa; border-radius: 10rpx; padding: 16rpx 20rpx; word-break: break-all; }

.step { display: flex; position: relative; padding-bottom: 32rpx; }
.step:last-child { padding-bottom: 0; }
.step-line { position: absolute; left: 17rpx; top: 36rpx; bottom: 0; width: 2rpx; background: #e5e7eb; }
.step-dot { width: 36rpx; height: 36rpx; border-radius: 50%; border: 4rpx solid #d9dee5; background: #fff; color: #fff; font-size: 20rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; }
.step-dot.done { background: #2e7d5b; border-color: #2e7d5b; }
.step-body { flex: 1; padding-left: 20rpx; }
.step-title { font-size: 28rpx; color: #9ca3af; }
.step-title.done { color: #1f2329; font-weight: 600; }
.step-desc { font-size: 24rpx; color: #8a9099; margin-top: 8rpx; }

.item-row { display: flex; align-items: center; padding: 12rpx 0; border-bottom: 2rpx solid #f3f4f6; }
.item-name { font-size: 28rpx; color: #1f2329; }
.item-price { font-size: 28rpx; color: #e34d4d; font-weight: 600; margin-left: 16rpx; }
.fee-row { padding: 10rpx 0; }
.pay-amount { font-size: 40rpx; font-weight: 700; color: #e34d4d; }
.refund-btn { color: #e34d4d; border-color: #fecaca; }
.return-notice { color: #d97706; background: #fff7ed; font-size: 26rpx; line-height: 1.6; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 101; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; border-bottom: 2rpx solid #f0f1f2; }
.sheet-close { font-size: 26rpx; color: #8a9099; padding: 8rpx 16rpx; }
.sheet-body { padding: 24rpx 32rpx 48rpx; }
