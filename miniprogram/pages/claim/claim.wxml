<view class="container">
    <view class="tabs">
        <view class="tab-item {{tab === 'goods' ? 'active' : ''}}" data-tab="goods" bindtap="switchTab">可申领商品</view>
        <view class="tab-item {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">我的申领</view>
    </view>

    <view wx:if="{{viewState === 'loading'}}" class="card center" style="padding:60rpx">
        <view class="spinner"></view><text class="state-text">加载中…</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="card center" style="padding:60rpx">
        <text class="state-icon">!</text><text class="state-text">{{errorMsg}}</text>
        <button class="ghost-btn mt16" size="mini" bindtap="retry">重试</button>
    </view>
    <block wx:else>
        <block wx:if="{{tab === 'goods'}}">
            <view class="card product-card" wx:for="{{products}}" wx:key="id">
                <view class="product-cover" wx:if="{{item.coverUrl}}">
                    <image src="{{item.coverUrl}}" mode="aspectFill" class="cover-img"></image>
                </view>
                <view class="cover-photo" wx:else>免</view>
                <view class="grow">
                    <view class="title">{{item.name}}</view>
                    <view class="subtitle mt8">免费申领 · 库存 {{item.stock}}</view>
                    <view class="text-muted mt8 desc">{{item.description}}</view>
                </view>
                <view class="claim-btn" data-id="{{item.id}}" bindtap="openOrder">去申领</view>
            </view>
            <view wx:if="{{products.length === 0}}" class="card center" style="padding:60rpx">
                <text class="state-icon">○</text><text class="state-text">暂无可申领商品</text>
            </view>
        </block>
        <block wx:else>
            <view class="card claim-card" wx:for="{{claims}}" wx:key="id">
                <view class="between">
                    <text class="title">{{item.productName}}</text>
                    <text class="tag">{{item.statusLabel}}</text>
                </view>
                <view class="text-muted mt8">申领单号：{{item.claimNo}}</view>
                <view class="row between mt8">
                    <text class="text-muted">{{item.timeText}}</text>
                    <text class="text-green">运费 {{item.freightAmount}} 元</text>
                </view>
            </view>
            <view wx:if="{{claims.length === 0}}" class="card center" style="padding:60rpx">
                <text class="state-icon">○</text><text class="state-text">暂无申领记录</text>
            </view>
        </block>
    </block>
</view>
