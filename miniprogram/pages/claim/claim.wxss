.tabs { display: flex; background: #fff; border-radius: 20rpx; padding: 8rpx; margin-bottom: 24rpx; }
.tab-item { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #8a9099; border-radius: 14rpx; }
.tab-item.active { background: #2e7d5b; color: #fff; font-weight: 600; }
.product-card { display: flex; align-items: center; }
.product-cover { width: 130rpx; height: 130rpx; border-radius: 14rpx; overflow: hidden; margin-right: 20rpx; flex-shrink: 0; }
.cover-img { width: 100%; height: 100%; }
.cover-photo { width: 130rpx; height: 130rpx; border-radius: 14rpx; background: #eaf5ef; color: #2e7d5b; font-size: 40rpx; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; }
.desc { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.claim-btn { background: #2e7d5b; color: #fff; font-size: 24rpx; padding: 12rpx 20rpx; border-radius: 30rpx; margin-left: 12rpx; flex-shrink: 0; }
