.tabs { display: flex; white-space: nowrap; background: #fff; border-radius: 16rpx; padding: 8rpx; margin-bottom: 20rpx; }
.tab { display: inline-block; padding: 14rpx 28rpx; font-size: 26rpx; color: #8a9099; border-radius: 12rpx; margin-right: 8rpx; }
.tab.active { background: #2e7d5b; color: #fff; font-weight: 600; }

.order-card { padding: 24rpx; }
.status-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 24rpx; background: #f3f4f6; color: #6b7280; }
.status-PAID { background: #fef3c7; color: #92400e; }
.status-SHIPPED { background: #dbeafe; color: #1e40af; }
.status-COMPLETED { background: #eaf5ef; color: #2e7d5b; }
.status-REFUNDED, .status-RETURN_APPLYING { background: #fee2e2; color: #991b1b; }
.goods-summary { font-size: 28rpx; color: #1f2329; line-height: 1.5; }
.amount { color: #e34d4d; font-size: 30rpx; font-weight: 700; }
.arrow { color: #c9cdd4; font-size: 34rpx; margin-left: 8rpx; }
.logistics { font-size: 24rpx; color: #2e7d5b; background: #f4fbf7; border-radius: 10rpx; padding: 10rpx 14rpx; }
