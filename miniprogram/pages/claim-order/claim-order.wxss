.p-cover { width: 140rpx; height: 140rpx; border-radius: 14rpx; overflow: hidden; margin-right: 20rpx; flex-shrink: 0; }
.p-photo { background: #eaf5ef; color: #2e7d5b; font-size: 40rpx; display: flex; align-items: center; justify-content: center; }
.cover-img { width: 100%; height: 100%; }
.link { font-size: 26rpx; padding: 20rpx 0 4rpx; }
.empty-tip { color: #e34d4d; font-size: 26rpx; padding: 16rpx 0; }
.freight-box { background: #f7f8fa; border-radius: 14rpx; padding: 20rpx; margin-top: 16rpx; }
.freight-num { font-size: 34rpx; font-weight: 700; }
.spinner.small { width: 28rpx; height: 28rpx; border-width: 4rpx; }
.tip { text-align: center; margin-top: 20rpx; font-size: 22rpx; }
