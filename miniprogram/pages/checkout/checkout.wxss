.address-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 2rpx solid #f0f1f2; }
.address-row.active { background: #f4fbf7; }
.radio { width: 40rpx; height: 40rpx; border: 3rpx solid #c9cdd4; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 26rpx; margin-right: 20rpx; flex-shrink: 0; }
.radio.on { background: #2e7d5b; border-color: #2e7d5b; }
.bold { font-size: 30rpx; font-weight: 600; margin-right: 20rpx; }
.empty-address { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; }
.mini-link { color: #2e7d5b; background: transparent; font-size: 24rpx; margin-left: 12rpx; padding: 0 16rpx; }
.mini-link::after { border: none; }
.warn-text { color: #d97706; font-size: 24rpx; margin-top: 12rpx; }
.fee-row { padding: 12rpx 0; }
.pay-amount { font-size: 44rpx; font-weight: 700; color: #e34d4d; }
