.login-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #2e7d5b 0%, #3a916c 30%, #f5f7fa 30%);
    padding: 60rpx 40rpx 40rpx;
}

.brand { text-align: center; color: #fff; margin-bottom: 48rpx; }
.logo {
    width: 120rpx; height: 120rpx; line-height: 120rpx; margin: 0 auto 20rpx;
    border-radius: 50%; background: rgba(255,255,255,0.2); border: 2rpx solid rgba(255,255,255,0.6);
    font-size: 56rpx; font-weight: 700;
}
.brand-name { font-size: 40rpx; font-weight: 700; }
.brand-slogan { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }

.card {
    background: #fff; border-radius: 24rpx; padding: 44rpx 36rpx 36rpx;
    box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.06);
}
.section-title { font-size: 32rpx; font-weight: 700; color: #111827; text-align: center; }
.hint { font-size: 24rpx; color: #9ca3af; text-align: center; margin-top: 10rpx; }
.match-tip { font-size: 24rpx; color: #2e7d5b; background: #eaf5ef; border-radius: 12rpx; padding: 14rpx 18rpx; text-align: center; margin-top: 14rpx; line-height: 1.5; }

.avatar-row { display: flex; flex-direction: column; align-items: center; margin: 40rpx 0 24rpx; }
.avatar-btn {
    width: 160rpx; height: 160rpx; padding: 0; margin: 0;
    border-radius: 50%; background: #f0f2f5; border: 2rpx solid #e5e7eb;
    display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 160rpx; height: 160rpx; }
.avatar-ph { font-size: 72rpx; color: #c0c6cf; line-height: 1; }
.avatar-tip { font-size: 24rpx; color: #6b7280; margin-top: 16rpx; }

.nickname-row {
    display: flex; align-items: center; gap: 20rpx;
    background: #f8fafc; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 24rpx;
}
.label { font-size: 28rpx; color: #374151; white-space: nowrap; }
.nickname-input { flex: 1; font-size: 28rpx; color: #111827; }

.phone-row {
    background: #f8fafc; border-radius: 12rpx; padding: 20rpx 24rpx; margin-bottom: 40rpx;
}
.phone-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.wx-phone-btn {
    font-size: 24rpx; color: #2e7d5b; background: #eaf5ef; border: none;
    border-radius: 24rpx; padding: 6rpx 20rpx; line-height: 1.6;
}
.wx-phone-btn::after { border: none; }
.phone-input { font-size: 28rpx; color: #111827; }
.phone-edit { font-size: 24rpx; color: #2e7d5b; text-align: right; margin-top: 10rpx; }
.phone-tip { font-size: 22rpx; color: #d97706; line-height: 1.6; margin-top: 10rpx; }

.login-btn { width: 100%; }
.hint-bottom { font-size: 22rpx; color: #b0b6bf; text-align: center; margin-top: 24rpx; }
