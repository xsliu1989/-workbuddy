<view class="login-page">
    <view class="brand">
        <view class="logo">绿</view>
        <view class="brand-name">绿益公益</view>
        <view class="brand-slogan">让每一份善意都被看见</view>
    </view>

    <view class="card">
        <view class="section-title">{{returning ? '欢迎回来' : '完善资料'}}</view>
        <view wx:if="{{checking}}" class="hint">正在匹配你的账号…</view>
        <view wx:elif="{{returning}}" class="match-tip">已自动带出你上次的资料，无需重复填写，直接登录即可</view>
        <view wx:else class="hint">授权头像昵称并留存手机号，用于公益身份、活动报名与证书</view>

        <view class="avatar-row">
            <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
                <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
                <view wx:else class="avatar-ph">+</view>
            </button>
            <view class="avatar-tip">点击选择微信头像</view>
        </view>

        <view class="nickname-row">
            <text class="label">姓名/昵称</text>
            <input type="nickname" class="nickname-input" placeholder="点击填写姓名或微信昵称" value="{{nickname}}" bindinput="onNicknameInput" />
        </view>

        <view class="phone-row">
            <view class="phone-head">
                <text class="label">手机号</text>
                <button class="wx-phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{resolvingPhone}}">微信一键填入</button>
            </view>
            <input type="number" class="phone-input" placeholder="请输入 11 位手机号" value="{{phone}}" maxlength="11" disabled="{{phoneReadonly}}" bindinput="onPhoneInput" />
            <view wx:if="{{phoneReadonly}}" class="phone-edit" bindtap="enableManualPhone">修改手机号</view>
            <view wx:if="{{phoneTip}}" class="phone-tip">{{phoneTip}}</view>
        </view>

        <button class="primary-btn login-btn" loading="{{logging}}" disabled="{{logging || checking}}" bindtap="doLogin">{{loginBtnText}}</button>
        <view class="hint-bottom">登录即表示同意《用户协议》与《隐私政策》，无需单独注册</view>
    </view>
</view>
