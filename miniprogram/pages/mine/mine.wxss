.login-card { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 80rpx 32rpx; margin-top: 40rpx; }
.login-logo { width: 128rpx; height: 128rpx; border-radius: 32rpx; background: linear-gradient(135deg,#2e7d5b,#1f5e44); color: #fff; font-size: 64rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.login-btn { width: 100%; margin-top: 48rpx; }

.profile-card { background: linear-gradient(135deg,#2e7d5b,#1f5e44); border-radius: 24rpx; padding: 36rpx 32rpx; color: #fff; }
.profile-top { min-height: 120rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; margin-right: 24rpx; overflow: hidden; flex-shrink: 0; }
.avatar-img { width: 100%; height: 100%; }
.avatar-letter { font-size: 44rpx; font-weight: 700; color: #fff; }
.profile-name { font-size: 40rpx; font-weight: 700; }
.profile-sub { font-size: 24rpx; opacity: 0.85; }
.profile-foot { margin-top: 32rpx; padding-top: 24rpx; border-top: 2rpx solid rgba(255,255,255,0.2); }
.profile-stat { display: flex; flex-direction: column; width: 50%; }
.profile-num { font-size: 30rpx; font-weight: 600; }
.profile-stat-label { font-size: 22rpx; opacity: 0.8; margin-top: 6rpx; }

.section-title { font-size: 30rpx; font-weight: 600; color: #1f2329; margin: 0 4rpx 16rpx; }
.entry-grid { display: flex; flex-wrap: wrap; padding: 16rpx 8rpx; }
.entry-item { width: 25%; display: flex; flex-direction: column; align-items: center; padding: 18rpx 0; }
.entry-icon { width: 88rpx; height: 88rpx; border-radius: 24rpx; color: #fff; font-size: 34rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.entry-label { font-size: 24rpx; color: #4e535b; margin-top: 12rpx; }

.logout-btn {
    width: 100%; background: #fff; color: #e34d4d; font-size: 28rpx;
    border: 2rpx solid #f0d5d5; border-radius: 44rpx; line-height: 2.2;
}
.logout-btn::after { border: none; }

.mask { position: fixed; left: 0; top: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.sheet { position: fixed; left: 0; right: 0; bottom: 0; max-height: 75vh; background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 101; display: flex; flex-direction: column; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 32rpx; border-bottom: 2rpx solid #f0f1f2; }
.sheet-close { font-size: 26rpx; color: #8a9099; padding: 8rpx 16rpx; }
.sheet-body { padding: 16rpx 24rpx 40rpx; overflow-y: auto; }
.list-item { padding: 24rpx 8rpx; border-bottom: 2rpx solid #f0f1f2; }

.chat-panel { position: fixed; left: 0; right: 0; bottom: 0; height: 78vh; background: #fff; border-radius: 28rpx 28rpx 0 0; z-index: 101; display: flex; flex-direction: column; }
.chat-body { flex: 1; padding: 24rpx; background: #f7f8fa; }
.msg-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg-row.me { flex-direction: row-reverse; }
.chat-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; background: #2e7d5b; color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.msg-row.me .chat-avatar { background: #c9cdd4; }
.bubble-wrap { max-width: 78%; margin: 0 16rpx; }
.bubble { background: #fff; border-radius: 16rpx; padding: 20rpx 24rpx; font-size: 28rpx; line-height: 1.6; color: #1f2329; word-break: break-all; }
.msg-row.me .bubble { background: #2e7d5b; color: #fff; }
.chat-typing { display: flex; align-items: center; justify-content: center; padding: 16rpx; }
.chat-typing .state-text { margin-top: 0; margin-left: 16rpx; }
.chat-input-row { display: flex; align-items: center; padding: 16rpx 24rpx; border-top: 2rpx solid #f0f1f2; }
.chat-input { flex: 1; background: #f7f8fa; border-radius: 40rpx; padding: 16rpx 28rpx; font-size: 28rpx; }
.chat-send { margin-left: 16rpx; padding: 0 32rpx; }
