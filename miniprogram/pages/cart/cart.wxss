.checkbox { width: 40rpx; height: 40rpx; border: 3rpx solid #c9cdd4; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 26rpx; margin-right: 20rpx; flex-shrink: 0; }
.checkbox.checked { background: #2e7d5b; border-color: #2e7d5b; }

.cart-img { width: 140rpx; height: 140rpx; border-radius: 12rpx; overflow: hidden; margin-right: 20rpx; flex-shrink: 0; background: #eef1f4; }
.img { width: 100%; height: 100%; }
.img-ph { display: flex; align-items: center; justify-content: center; color: #b9c0c9; font-size: 40rpx; }
.cart-info { min-width: 0; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 48rpx; height: 48rpx; border: 2rpx solid #e5e7eb; border-radius: 10rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #4e535b; }
.step-num { min-width: 60rpx; text-align: center; font-size: 28rpx; }
.del-btn { font-size: 40rpx; color: #c9cdd4; margin-left: 16rpx; padding: 8rpx; }

.checkout-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; background: #fff; padding: 16rpx 24rpx; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); z-index: 20; }
.all-label { font-size: 28rpx; color: #4e535b; }
.total-box { text-align: right; margin: 0 20rpx; }
.total-num { font-size: 36rpx; font-weight: 700; color: #e34d4d; }
.checkout-btn { width: 240rpx; }
