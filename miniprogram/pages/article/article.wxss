.article-detail { padding: 32rpx; }
.d-cover { width: 100%; margin: 8rpx 0 24rpx; }
.video { width: 100%; height: 420rpx; }
.article-cover-img { width: 100%; height: 360rpx; border-radius: 14rpx; margin: 8rpx 0 24rpx; }
.body-text { font-size: 30rpx; line-height: 1.9; color: #4e535b; white-space: pre-wrap; }
.share-bar { padding: 8rpx 12rpx; }
.article-list-item { display: flex; align-items: center; }
.article-list-item .article-cover { width: 140rpx; height: 110rpx; border-radius: 12rpx; overflow: hidden; margin-right: 20rpx; flex-shrink: 0; }
.article-list-item .cover-img { width: 100%; height: 100%; }
