<view class="container">
    <view wx:if="{{viewState === 'loading'}}" class="card center state-box">
        <view class="spinner"></view>
        <text class="state-text">正在准备捐赠表单…</text>
    </view>
    <view wx:elif="{{viewState === 'error'}}" class="card center state-box">
        <text class="state-icon">!</text>
        <text class="state-text">加载失败，请重试</text>
        <button class="ghost-btn mt16" size="mini" bindtap="retryLoad">重试</button>
    </view>

    <block wx:else>
        <!-- 常用功能入口前置：用户一进来就能看到捐赠记录 -->
        <view class="card record-entry" bindtap="goRecords" hover-class="entry-hover">
            <view class="record-icon">▤</view>
            <view class="grow">
                <view class="record-title">我的捐赠记录</view>
                <view class="record-sub">查看捐赠单、评估进度与公益积分</view>
            </view>
            <text class="record-arrow">›</text>
        </view>

        <view class="card">
            <view class="title-lg">物资捐赠</view>
            <view class="subtitle mt8">填写物资信息，提交后由评估员接收并估值</view>
            <view class="divider"></view>

            <view class="form-item">
                <view class="form-label required">物资类别</view>
                <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="onCategoryChange">
                    <view class="form-input picker-value">{{categories[categoryIndex].label}}</view>
                </picker>
            </view>

            <view class="form-item">
                <view class="form-label required">数量</view>
                <input class="form-input" type="number" value="{{quantity}}" bindinput="onQuantityInput" placeholder="请输入数量" />
            </view>

            <view class="form-item">
                <view class="form-label required">物资描述</view>
                <textarea class="form-textarea" value="{{description}}" bindinput="onDescInput" placeholder="例如：八成新羽绒服 3 件，图书约 20 册" />
            </view>

            <view class="form-item">
                <view class="form-label">物资照片（选填，最多 6 张）</view>
                <view class="photo-grid">
                    <view class="photo-item" wx:for="{{photoList}}" wx:key="*this">
                        <image src="{{item}}" mode="aspectFill" class="photo-thumb" data-src="{{item}}" bindtap="previewPhoto"></image>
                        <view class="photo-remove" data-index="{{index}}" bindtap="removePhoto">×</view>
                    </view>
                    <view wx:if="{{photoList.length < 6}}" class="photo-add" bindtap="choosePhotos">
                        <text class="photo-add-icon">{{uploadingPhotos ? '…' : '+'}}</text>
                        <text class="photo-add-text">{{uploadingPhotos ? '上传中' : '拍照/相册'}}</text>
                    </view>
                </view>
            </view>

            <view class="form-item">
                <view class="form-label required">交投方式</view>
                <picker mode="selector" range="{{deliveryTypes}}" range-key="label" value="{{deliveryIndex}}" bindchange="onDeliveryChange">
                    <view class="form-input picker-value">{{deliveryTypes[deliveryIndex].label}}</view>
                </picker>
            </view>

            <!-- 快递邮寄：展示管理端维护的接收地址 -->
            <view wx:if="{{isMail}}" class="mail-section">
                <view class="form-label required">邮寄接收地址</view>
                <block wx:if="{{mailAddresses.length}}">
                    <picker mode="selector" range="{{mailAddresses}}" range-key="pickerLabel" value="{{mailAddressIndex}}" bindchange="onMailAddressChange">
                        <view class="form-input picker-value mail-picker">{{mailAddressIndex >= 0 ? mailAddresses[mailAddressIndex].pickerLabel : '请选择邮寄地址'}}</view>
                    </picker>
                    <view wx:if="{{selectedAddress}}" class="address-detail">
                        <view class="address-row">
                            <text class="address-label">收件人</text>
                            <text class="grow">{{selectedAddress.receiver}}　{{selectedAddress.phone}}</text>
                        </view>
                        <view class="address-row">
                            <text class="address-label">地址</text>
                            <text class="grow">{{selectedAddress.fullAddress}}</text>
                        </view>
                        <view wx:if="{{selectedAddress.postalCode}}" class="address-row">
                            <text class="address-label">邮编</text>
                            <text class="grow">{{selectedAddress.postalCode}}</text>
                        </view>
                        <view wx:if="{{selectedAddress.remark}}" class="address-remark">{{selectedAddress.remark}}</view>
                    </view>
                </block>
                <view wx:else class="mail-empty">
                    <text>暂无可用的邮寄地址，请选择「线下交投点」或「上门取件」</text>
                </view>
            </view>
        </view>

        <button class="primary-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitDonation">提交捐赠</button>
    </block>
</view>
