.container { padding-bottom: 20rpx; }
.pd-gallery { width: 100%; height: 560rpx; background: #fff; margin-bottom: 24rpx; }
.pd-swiper, .pd-gallery-img { width: 100%; height: 560rpx; }
.pd-ph { display: flex; align-items: center; justify-content: center; background: #f3f4f6; color: #cbd5e1; font-size: 72rpx; }
.pd-price { font-size: 48rpx; color: #e34d4d; font-weight: 700; margin-top: 16rpx; }
.pd-rich { margin-top: 16rpx; font-size: 28rpx; color: #374151; line-height: 1.7; word-break: break-all; }
.pd-rich image { max-width: 100%; height: auto; }
.pd-after { margin-top: 16rpx; font-size: 28rpx; color: #4b5563; line-height: 1.7; white-space: pre-wrap; }

/* 底部购买栏 */
.pd-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,.06); }
.pd-bar-left { display: flex; flex-direction: column; align-items: center; width: 90rpx; flex-shrink: 0; }
.pd-cart-icon { width: 56rpx; height: 56rpx; border-radius: 50%; background: #ecfdf5; color: #0f9d63; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.pd-cart-label { font-size: 20rpx; color: #6b7280; margin-top: 6rpx; }
.pd-qty { display: flex; align-items: center; border: 1rpx solid #e5e7eb; border-radius: 10rpx; overflow: hidden; flex-shrink: 0; }
.qty-btn { width: 52rpx; height: 60rpx; line-height: 60rpx; text-align: center; font-size: 32rpx; color: #374151; background: #f9fafb; }
.qty-num { min-width: 52rpx; text-align: center; font-size: 28rpx; color: #1f2937; }
.pd-add { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; background: #fff; border: 1rpx solid #0f9d63; color: #0f9d63; font-size: 28rpx; padding: 0; }
.pd-add::after { border: none; }
.pd-buy { flex: 1; height: 76rpx; line-height: 76rpx; border-radius: 38rpx; font-size: 28rpx; padding: 0; margin: 0; }
